generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostType {
  BLOG
  TERMIN
  TURNIER
}

enum InstagramStatus {
  PENDING
  QUEUED
  POSTED
  FAILED
}

enum BankDataAccessKind {
  SINGLE_REVEAL
  CSV_EXPORT
}

enum GameInventoryStatus {
  ACTIVE
  MAINTENANCE
  DEINVENTARISED
}

enum StorageUnitKind {
  BOX
  SHELF
}

enum BoardGameKind {
  BOARDGAME
  BOARDGAME_EXPANSION
}

enum HoldingOrigin {
  INITIAL
  LOAN
  RETURN
  HANDOVER
  RELOCATION
}

enum ShiftType {
  THEKE
  KASSE
  LEIHE
}

enum ExplainerExperienceLevel {
  WITH_MANUAL
  WITHOUT_MANUAL
  BY_HEART
}

enum FleaMarketItemStatus {
  PENDING
  FOR_SALE
  RESERVED
  SOLD
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String
  roles       RolePermission[]

  @@map("permissions")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  neonAuthUserId String
  roleId         String
  role           Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([neonAuthUserId, roleId])
  @@map("user_roles")
}

/// Mitgliedsprofil, 1:1 zum Login-Konto (siehe docs/adr/0002).
/// Der Mitgliedschaftszustand wird aus resignedAt/membershipEndsAt/anonymizedAt abgeleitet.
model Meeple {
  id               String    @id @default(cuid())
  neonAuthUserId   String?   @unique
  memberNumber     Int       @unique @default(autoincrement())
  displayName      String
  email            String?
  joinedAt         DateTime  @default(now())
  resignedAt       DateTime?
  membershipEndsAt DateTime?
  anonymizedAt     DateTime?
  ibanEncrypted    String?
  ibanLast4        String?
  accountHolder    String?
  bggUsername      String?
  bgaUsername      String?
  telegramHandle   String?
  signalHandle     String?
  discordHandle    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  bankDataAccessesMade      BankDataAccessLog[] @relation("BankDataAccessActor")
  bankDataAccessesReceived  BankDataAccessLog[] @relation("BankDataAccessSubject")
  keptUnits                 StorageUnit[]       @relation("StorageUnitKeeper")
  recordedUnitMoves         StorageUnitMove[]   @relation("StorageUnitMoveRecorder")
  movedUnitsAsKeeper        StorageUnitMove[]   @relation("StorageUnitMoveKeeper")
  holdings                  GameHolding[]       @relation("GameHoldingMeeple")
  recordedHoldings          GameHolding[]       @relation("GameHoldingRecorder")
  lfgPosts                  LfgPost[]           @relation("LfgPostCreator")
  lfgParticipations         LfgParticipant[]
  shiftBookings             ShiftBooking[]      @relation("ShiftBookingMeeple")
  explainerGames            ExplainerGame[]       @relation("ExplainerGameMeeple")
  explainerAttendances      ExplainerAttendance[] @relation("ExplainerAttendanceMeeple")
  fleaMarketItems           FleaMarketItem[]      @relation("FleaMarketItemSeller")
  sparePartListingsKept     SparePartListing[]    @relation("SparePartListingKeeper")

  @@map("meeples")
}

/// A player-search post. `gameTitle` is deliberately free text, not a relation to
/// BoardGame — a Gesuch can be for a title the club doesn't own (see docs/schema.md).
model LfgPost {
  id                String    @id @default(cuid())
  title             String
  gameTitle         String?
  description       String
  plannedAt         DateTime?
  dateNote          String?
  location          String?
  maxParticipants   Int
  createdByMeepleId String
  closedAt          DateTime?
  createdAt         DateTime  @default(now())

  createdBy    Meeple           @relation("LfgPostCreator", fields: [createdByMeepleId], references: [id], onDelete: Cascade)
  participants LfgParticipant[]

  @@index([createdByMeepleId])
  @@map("lfg_posts")
}

model LfgParticipant {
  postId   String
  meepleId String
  joinedAt DateTime @default(now())

  post   LfgPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  meeple Meeple  @relation(fields: [meepleId], references: [id], onDelete: Cascade)

  @@id([postId, meepleId])
  @@map("lfg_participants")
}

/// Audit trail for every decrypted read of bank data (see docs/adr/0003). Kept 24 months.
model BankDataAccessLog {
  id                 String             @id @default(cuid())
  accessedByMeepleId String
  subjectMeepleId    String?
  kind               BankDataAccessKind
  at                 DateTime           @default(now())

  accessedBy Meeple  @relation("BankDataAccessActor", fields: [accessedByMeepleId], references: [id], onDelete: Cascade)
  subject    Meeple? @relation("BankDataAccessSubject", fields: [subjectMeepleId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([subjectMeepleId])
  @@map("bank_data_access_logs")
}

model Post {
  id                 String           @id @default(cuid())
  slug               String           @unique
  type               PostType
  title              String
  excerpt            String
  body               String
  date               DateTime
  author             String?
  location           String?
  internal           Boolean?
  instagram          Boolean?
  coverImageUrl      String?
  instagramStatus    InstagramStatus?
  instagramPostUrl   String?
  instagramAttempts  Int              @default(0)
  instagramLastError String?

  @@map("posts")
}

model Invite {
  id              String    @id @default(cuid())
  token           String    @unique
  createdByUserId String
  expiresAt       DateTime
  redeemedAt      DateTime?

  @@map("invites")
}

model BoardGame {
  id              String              @id @default(cuid())
  slug            String              @unique
  title           String
  /// Indexed, deliberately NOT unique — duplicates of a title are allowed (ADR 0001).
  bggId           Int?
  /// The manufacturer barcode identifies the product, not the single game — never unique.
  ean             String?
  minPlayers      Int?
  maxPlayers      Int?
  playTimeMinutes Int?
  weight          Float?
  imageUrl        String?
  description     String?
  mechanics       String[]
  /// Removed together with `location` in step 14, once the holding migration has run.
  quantity        Int                 @default(1)
  location        String?
  /// The single condition note — a defect is recorded here, not in a second field.
  condition       String?
  needsCompletenessCheck Boolean      @default(false)
  lastCheckedAt   DateTime?
  status          GameInventoryStatus @default(ACTIVE)
  archivedAt      DateTime?
  archivedReason  String?
  /// Best-effort auto-populated from the BGG videos block (see docs/adr, step 11); manually correctable.
  explainerVideoUrl String?
  /// Distinguishes an expansion from a standalone game (BGG `type` attribute), see #30.
  kind            BoardGameKind       @default(BOARDGAME)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  holdings GameHolding[]
  explainerGames ExplainerGame[]
  baseGameCollections  GameCollection[] @relation("BaseGameCollections")
  expansionCollections GameCollection[] @relation("ExpansionCollections")
  sparePartListings    SparePartListing[]

  @@index([bggId])
  @@index([ean])
  @@map("board_games")
}

/// A batch of spare parts kept for a game, or "Allgemeines" (`boardGameId: null`)
/// for parts with no game reference at all. Self-service list, no sold/taken workflow.
model SparePartListing {
  id             String    @id @default(cuid())
  title          String
  boardGameId    String?
  condition      String
  description    String?
  keeperMeepleId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  boardGame BoardGame? @relation(fields: [boardGameId], references: [id], onDelete: SetNull)
  keeper    Meeple     @relation("SparePartListingKeeper", fields: [keeperMeepleId], references: [id], onDelete: Restrict)

  @@index([boardGameId])
  @@index([keeperMeepleId])
  @@map("spare_part_listings")
}

/// Links an expansion to its base game(s), see #30. m:n because BGG allows a
/// crossover expansion to belong to more than one base game.
model GameCollection {
  baseGameId  String
  expansionId String

  baseGame  BoardGame @relation("BaseGameCollections", fields: [baseGameId], references: [id], onDelete: Cascade)
  expansion BoardGame @relation("ExpansionCollections", fields: [expansionId], references: [id], onDelete: Cascade)

  @@id([baseGameId, expansionId])
  @@map("game_collections")
}

/// A QR-labelled physical container: a box that travels as a whole, or a club-owned shelf.
/// Units can nest (box in shelf) and end up with a keeper (see CONTEXT.md).
model StorageUnit {
  id             String          @id @default(cuid())
  code           String          @unique
  kind           StorageUnitKind
  label          String
  parentUnitId   String?
  keeperMeepleId String?
  /// Free text, only meaningful where no parent unit exists. Independent of the keeper.
  locationNote   String?
  retiredAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  parentUnit StorageUnit?      @relation("StorageUnitTree", fields: [parentUnitId], references: [id], onDelete: SetNull)
  childUnits StorageUnit[]     @relation("StorageUnitTree")
  keeper     Meeple?           @relation("StorageUnitKeeper", fields: [keeperMeepleId], references: [id], onDelete: SetNull)
  moves      StorageUnitMove[]
  holdings   GameHolding[]
  eventShelfAssignments EventShelfAssignment[]

  @@index([parentUnitId])
  @@index([keeperMeepleId])
  @@map("storage_units")
}

/// Lean history of where a unit stood, so "who had this box when" is answerable
/// without loading it onto every game query.
model StorageUnitMove {
  id                 String    @id @default(cuid())
  unitId             String
  keeperMeepleId     String?
  parentUnitId       String?
  locationNote       String?
  startedAt          DateTime  @default(now())
  endedAt            DateTime?
  recordedByMeepleId String

  unit       StorageUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  keeper     Meeple?     @relation("StorageUnitMoveKeeper", fields: [keeperMeepleId], references: [id], onDelete: SetNull)
  recordedBy Meeple      @relation("StorageUnitMoveRecorder", fields: [recordedByMeepleId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@map("storage_unit_moves")
}

/// Where a game was during a period. Exactly one target (unit or meeple) and exactly
/// one open holding per game — both enforced by hand-written constraints, see ADR 0001.
model GameHolding {
  id                 String        @id @default(cuid())
  boardGameId        String
  unitId             String?
  meepleId           String?
  origin             HoldingOrigin
  startedAt          DateTime      @default(now())
  endedAt            DateTime?
  /// Empty while only the handing-over side has recorded the holding.
  confirmedAt        DateTime?
  recordedByMeepleId String
  note               String?

  boardGame  BoardGame    @relation(fields: [boardGameId], references: [id], onDelete: Cascade)
  unit       StorageUnit? @relation(fields: [unitId], references: [id], onDelete: Restrict)
  meeple     Meeple?      @relation("GameHoldingMeeple", fields: [meepleId], references: [id], onDelete: Restrict)
  recordedBy Meeple       @relation("GameHoldingRecorder", fields: [recordedByMeepleId], references: [id], onDelete: Cascade)

  @@index([boardGameId])
  @@index([unitId])
  @@index([meepleId])
  @@map("game_holdings")
}

/// A play day or larger event, independent of the public/internal ICS calendar feed
/// (see docs/adr/0004). The basis for shifts, explainer attendance and flea market items.
model Event {
  id        String    @id @default(cuid())
  slug      String    @unique
  title     String
  startsAt  DateTime
  endsAt    DateTime?
  location  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  shifts          Shift[]
  shelfAssignments EventShelfAssignment[]
  explainerAttendances ExplainerAttendance[]
  fleaMarketItems FleaMarketItem[]

  @@map("events")
}

/// Which shelves are set up at an event. Purely informational — it never changes a
/// GameHolding, it only narrows what the guest area shows as "im Raum" (see CONTEXT.md).
model EventShelfAssignment {
  eventId String
  unitId  String

  event Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  unit  StorageUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([eventId, unitId])
  @@map("event_shelf_assignments")
}

/// A time slot with a fixed type and capacity within an event, self-service bookable
/// by members. Booking a KASSE shift grants time-bound flea market rights (ADR 0006).
model Shift {
  id        String    @id @default(cuid())
  eventId   String
  type      ShiftType
  startsAt  DateTime
  endsAt    DateTime
  capacity  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookings ShiftBooking[]

  @@index([eventId])
  @@map("shifts")
}

/// A member's booking of a shift. `uncertain` marks an unsure commitment but still
/// counts against capacity — the simplest rule that avoids overbooking.
model ShiftBooking {
  shiftId   String
  meepleId  String
  uncertain Boolean  @default(false)
  createdAt DateTime @default(now())

  shift  Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  meeple Meeple @relation("ShiftBookingMeeple", fields: [meepleId], references: [id], onDelete: Cascade)

  @@id([shiftId, meepleId])
  @@map("shift_bookings")
}

/// A Meeple's durable profile as an Erklärbär for one game, with an experience level.
/// Combined with ExplainerAttendance for an event, this yields "heute hier erklärbar".
model ExplainerGame {
  id          String                   @id @default(cuid())
  meepleId    String
  boardGameId String
  level       ExplainerExperienceLevel
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  meeple    Meeple    @relation("ExplainerGameMeeple", fields: [meepleId], references: [id], onDelete: Cascade)
  boardGame BoardGame @relation(fields: [boardGameId], references: [id], onDelete: Cascade)

  @@unique([meepleId, boardGameId])
  @@map("explainer_games")
}

/// A Meeple marking themselves present as an Erklärbär at an event (see CONTEXT.md).
model ExplainerAttendance {
  eventId   String
  meepleId  String
  createdAt DateTime @default(now())

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  meeple Meeple @relation("ExplainerAttendanceMeeple", fields: [meepleId], references: [id], onDelete: Cascade)

  @@id([eventId, meepleId])
  @@map("explainer_attendances")
}

/// A member's item for an event's Bring & Buy flea market. Starts PENDING and only
/// appears in the guest area once approved (see CONTEXT.md "Flohmarkt-Artikel").
model FleaMarketItem {
  id                  String               @id @default(cuid())
  code                String               @unique
  eventId             String
  sellerMeepleId      String
  title               String
  description         String?
  priceEuros          Int
  status              FleaMarketItemStatus @default(PENDING)
  approvedAt          DateTime?
  approvedByMeepleId  String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seller Meeple @relation("FleaMarketItemSeller", fields: [sellerMeepleId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([sellerMeepleId])
  @@map("flea_market_items")
}

model InstagramConnection {
  id                  String   @id @default(cuid())
  accessToken         String
  igBusinessAccountId String
  pageId              String
  expiresAt           DateTime
  updatedAt           DateTime @updatedAt

  @@map("instagram_connections")
}
