generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostType {
  BLOG
  TERMIN
  TURNIER
}

enum InstagramStatus {
  PENDING
  QUEUED
  POSTED
  FAILED
}

enum GameInventoryStatus {
  ACTIVE
  DEINVENTARISED
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String
  roles       RolePermission[]

  @@map("permissions")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  neonAuthUserId String
  roleId         String
  role           Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([neonAuthUserId, roleId])
  @@map("user_roles")
}

/// Mitgliedsprofil, 1:1 zum Login-Konto (siehe docs/adr/0002).
/// Der Mitgliedschaftszustand wird aus resignedAt/membershipEndsAt/anonymizedAt abgeleitet.
model Meeple {
  id               String    @id @default(cuid())
  neonAuthUserId   String?   @unique
  memberNumber     Int       @unique @default(autoincrement())
  displayName      String
  email            String?
  joinedAt         DateTime  @default(now())
  resignedAt       DateTime?
  membershipEndsAt DateTime?
  anonymizedAt     DateTime?
  ibanEncrypted    String?
  ibanLast4        String?
  accountHolder    String?
  bggUsername      String?
  bgaUsername      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("meeples")
}

model Post {
  id                 String           @id @default(cuid())
  slug               String           @unique
  type               PostType
  title              String
  excerpt            String
  body               String
  date               DateTime
  author             String?
  location           String?
  internal           Boolean?
  instagram          Boolean?
  coverImageUrl      String?
  instagramStatus    InstagramStatus?
  instagramPostUrl   String?
  instagramAttempts  Int              @default(0)
  instagramLastError String?

  @@map("posts")
}

model Invite {
  id              String    @id @default(cuid())
  token           String    @unique
  createdByUserId String
  expiresAt       DateTime
  redeemedAt      DateTime?

  @@map("invites")
}

model BoardGame {
  id              String              @id @default(cuid())
  slug            String              @unique
  title           String
  bggId           Int?                @unique
  minPlayers      Int?
  maxPlayers      Int?
  playTimeMinutes Int?
  weight          Float?
  imageUrl        String?
  description     String?
  mechanics       String[]
  quantity        Int                 @default(1)
  location        String?
  condition       String?
  status          GameInventoryStatus @default(ACTIVE)
  archivedAt      DateTime?
  archivedReason  String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@map("board_games")
}

model InstagramConnection {
  id                  String   @id @default(cuid())
  accessToken         String
  igBusinessAccountId String
  pageId              String
  expiresAt           DateTime
  updatedAt           DateTime @updatedAt

  @@map("instagram_connections")
}
