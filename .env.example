# Copy to .env.local and fill in real values. Never commit .env.local.

# "development" | "preview" | "production"
ENVIRONMENT="example" 

# Neon PostgreSQL connection string (Neon dashboard → Connection Details).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Public Google Calendar ICS feed (read-only, no API key needed).
PUBLIC_CALENDAR_ICS_URL="https://calendar.google.com/calendar/ical/example%40group.calendar.google.com/public/basic.ics"

# Members-only ICS feed (internal club dates). Optional — without it the internal
# calendar simply shows no internal events instead of failing.
ICS_FEED_URL_INTERNAL="https://calendar.google.com/calendar/ical/internal%40group.calendar.google.com/private-xxxx/basic.ics"

# --- Member data encryption (IBANs, see docs/adr/0003) ---
# AES-256-GCM key, base64-encoded 32 bytes. Generate with:
#   openssl rand -base64 32
# Back this up OUTSIDE Vercel. If the key is lost, every stored IBAN is
# unrecoverable — only the last four digits (stored in clear text) remain readable.
# Rotating the key invalidates all existing ciphertexts; members have to re-enter their IBAN.
MEMBER_DATA_ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"

# --- Neon Auth (Managed Better Auth) ---
NEON_AUTH_BASE_URL="https://example.neonauth.example.aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="generate-a-random-secret"

# --- Seed admin (used by `pnpm db:seed`) ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
SEED_DEMO_PASSWORD="change-me"

# --- Instagram cross-posting (Meta Graph API) ---
# Meta Developer Portal → your app → App settings → Basic.
META_APP_ID="000000000000000"
META_APP_SECRET="generate-in-meta-developer-portal"
# Must match a redirect URI registered for the Instagram product in the Meta app.
META_REDIRECT_URI="http://localhost:3000/api/auth/instagram/callback"
# Meta Graph API version to target, see https://developers.facebook.com/docs/graph-api/changelog
META_GRAPH_API_VERSION="v21.0"
# Shared secret for the Vercel cron endpoint (Authorization: Bearer <CRON_SECRET>). Generate with `openssl rand -hex 32`.
CRON_SECRET="generate-a-random-secret"
# Public site origin, used to build the Instagram caption's link back to the post.
PUBLIC_SITE_URL="https://oecher-meeples.org"

# --- Newsletter (Brevo) ---
BREVO_API_KEY="generate-in-brevo-dashboard"
# Must be a verified sender in the Brevo dashboard.
BREVO_SENDER_EMAIL="newsletter@oecher-meeples.org"
BREVO_SENDER_NAME="Oecher Meeples"

# --- Blob storage ---
BLOB_STORE_ID="store_xxxxx"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxx"

# --- BGG Bearer API (required by BGG's XML API2 since July 2025) ---
# Register your application at BoardGameGeek to obtain a token.
BGG_BEARER_TOKEN="generate-via-BGG-account"

# --- Feedback-Button (Header, #282) ---
# Fine-grained GitHub PAT mit "Issues: Read and write" auf oecher-meeples/portal —
# legt Feedback als Sub-Issue am Feedback-Epic (#281) an.
GITHUB_TOKEN="generate-a-fine-grained-github-pat"

# --- Übersetzung (MyMemory API, übersetzt BGG-Import-Beschreibung ins Deutsche, #184) ---
# Kein API-Key nötig — kostenlos ohne Anmeldung/Kreditkarte, siehe
# https://mymemory.translated.net/doc/spec.php. TRANSLATION_CONTACT_EMAIL ist
# optional (keine echte Registrierung) und hebt das Tageslimit von 5.000 auf
# 50.000 Zeichen an.
TRANSLATION_CONTACT_EMAIL="kontakt@oecher-meeples.org"

# --- YouTube Data API v3 (Video-Suche, #185-Folge) ---
# Kein Abrechnungskonto/Kreditkarte nötig — 100 Suchanfragen/Tag im
# kostenlosen Standard-Kontingent, kein Pay-as-you-go. API-Key erzeugen:
# https://console.cloud.google.com/apis/credentials (Projekt anlegen, YouTube
# Data API v3 aktivieren, API-Key erstellen).
YOUTUBE_API_KEY="generate-in-google-cloud-console"

# --- EAN-Namenssuche (UPCitemdb, #197) ---
# Kein API-Key/Env-Var nötig — EAN-Search.org (im Issue ursprünglich
# vorgesehen) ist entgegen der Annahme kostenpflichtig ab dem ersten Monat
# (1€, danach 9€/Monat, Zahlungsmittel schon bei Registrierung Pflicht).
# UPCitemdb's Trial-Tier ist echt kostenlos und keyless, aber ein US-lastiger
# Retail-Scrape-Katalog — Trefferqualität für (insbesondere deutsche)
# Brettspiele ist Best-Effort, siehe lib/upc-lookup/client.ts.
