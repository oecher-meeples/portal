{
  "threshold": 100,
  "reporters": ["consoleFull"],
  "absolute": false,
  "gitignore": true,
  "minLines": 12,
  "minTokens": 90,
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__fixtures__/**",
    "**/__mocks__/**"
  ],
  "format": ["typescript", "tsx"]
}
