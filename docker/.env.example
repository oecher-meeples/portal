# Self-hosting environment for docker-compose.yml (see docs/deployment-docker.md).
#
#   cp docker/.env.example .env     # in the repo root, next to docker-compose.yml
#
# docker compose reads `.env` from the project directory automatically and
# passes the values into the containers. Never commit `.env`.
#
# The root `.env.example` is the LOCAL-DEVELOPMENT counterpart (`pnpm dev`
# on the host, reaching postgres/seaweedfs via localhost). This file is for
# the containerised app: it reaches postgres/seaweedfs via their compose
# service names, while everything a BROWSER sees must be a real public URL.
#
# REQUIRED = compose refuses to start without it (`${VAR:?}` in
# docker-compose.yml). Everything else is optional.
# Generate secrets with the `openssl` command noted next to each value.

# Shown in the header logo tooltip for anything other than "production".
ENVIRONMENT="production"

# --- Public URLs (what browsers / external services reach) ---
# REQUIRED. Base URL of the portal, no trailing slash, no /api/auth.
BETTER_AUTH_URL="https://portal.example.org"
# REQUIRED. Used for links in mails, Instagram captions and calendar
# subscription URLs — normally identical to BETTER_AUTH_URL.
PUBLIC_SITE_URL="https://portal.example.org"
# REQUIRED. Public origin of the blob storage (images + direct browser
# uploads). Stored blob URLs are built from it — changing it later breaks
# existing URLs in the database. Points at SeaweedFS (127.0.0.1:8333 on the
# host) through your reverse proxy, or at S3_DOMAIN with the caddy profile.
S3_PUBLIC_ENDPOINT="https://files.portal.example.org"
# Optional, comma-separated extra origins allowed to call /api/auth.
BETTER_AUTH_TRUSTED_ORIGINS=""

# --- Bundled reverse proxy (only with `--profile with-proxy`) ---
# Bare hostnames (no scheme). DNS must point at this host, ports 80/443 open.
# Must match BETTER_AUTH_URL/PUBLIC_SITE_URL and S3_PUBLIC_ENDPOINT above.
APP_DOMAIN="portal.example.org"
S3_DOMAIN="files.portal.example.org"

# --- Database (postgres service) ---
POSTGRES_USER="meeples"
# REQUIRED. Keep it URL-safe — it is embedded in the app's DATABASE_URL.
#   openssl rand -hex 24
POSTGRES_PASSWORD="generate-with-openssl-rand-hex-24"
POSTGRES_DB="meeples"
# Optional override. By default docker-compose.yml builds it as
#   postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@postgres:5432/$POSTGRES_DB
# Only set it to use an external Postgres instead of the bundled container.
# DATABASE_URL="postgresql://user:password@db.example.org:5432/meeples?sslmode=require"

# --- Auth & secrets ---
# REQUIRED. Signs session cookies, reset tokens and the Instagram OAuth state.
# Rotating it logs everyone out.  openssl rand -base64 32
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
# REQUIRED. AES-256-GCM key for stored IBANs (docs/adr/0003).
#   openssl rand -base64 32
# BACK IT UP outside this server. Lost key = every stored IBAN unrecoverable;
# rotating it invalidates all existing ciphertexts.
MEMBER_DATA_ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"
# REQUIRED. Bearer token between cron-sidecar and the app's /api/cron/* routes.
#   openssl rand -hex 32
CRON_SECRET="generate-with-openssl-rand-hex-32"

# --- First-start seed (only runs while the database has no users) ---
# Needed for the FIRST start: creates the admin login. The container refuses
# to start on an empty database without them; afterwards they are ignored
# (changing them does not change the existing admin's password).
SEED_ADMIN_EMAIL="admin@example.org"
SEED_ADMIN_PASSWORD="change-me-before-first-start"
# "true" additionally seeds demo games, members, posts, … — for evaluation
# instances only, never for a real club database.
SEED_DEMO_DATA="false"
# Password of the demo accounts (only with SEED_DEMO_DATA=true).
SEED_DEMO_PASSWORD="change-me"

# --- Blob storage (seaweedfs + seaweedfs-init services) ---
# Admin identity — only used by seaweedfs-init to create the bucket and its
# public-read policy, never by the app itself.
# REQUIRED (both).  openssl rand -hex 20
SEAWEEDFS_ADMIN_ACCESS_KEY="generate-with-openssl-rand-hex-20"
SEAWEEDFS_ADMIN_SECRET_KEY="generate-with-openssl-rand-hex-20"
# The app's own, more restricted identity (Read/Write/List, no policy admin).
# REQUIRED (both).  openssl rand -hex 20
S3_ACCESS_KEY="meeples-app"
S3_SECRET_KEY="generate-with-openssl-rand-hex-20"
S3_BUCKET="meeples"
# Optional soft quota for the admin dashboard's fill-level card (default 1 GB).
# S3_STORAGE_LIMIT_BYTES="1073741824"
# Defaults that rarely need changing (app reaches SeaweedFS inside the
# network; CORS for direct browser uploads is "*" by default in the image):
# S3_ENDPOINT="http://seaweedfs:8333"
# S3_REGION="us-east-1"

# --- E-Mail (SMTP, optional) ---
# Without SMTP_HOST every mail (newsletter, password reset, member
# notifications) is logged and dropped instead of sent — no crash.
# No mail server ships with this stack; use your provider's SMTP relay.
SMTP_HOST=""
# 587 = STARTTLS (default), 465 = implicit TLS.
SMTP_PORT="587"
# Leave SMTP_USER empty for an unauthenticated relay.
SMTP_USER=""
SMTP_PASS=""
# Sender; must be allowed by your provider (SPF/DKIM for the domain).
SMTP_FROM='"Oecher Meeples" <newsletter@example.org>'

# --- Calendar (optional, public/secret ICS feed URLs, no API key) ---
PUBLIC_CALENDAR_ICS_URL=""
ICS_FEED_URL_INTERNAL=""

# --- External APIs: bring your own keys (each optional, only its feature fails) ---
# Instagram cross-posting (Meta Developer Portal → App settings → Basic).
META_APP_ID=""
META_APP_SECRET=""
# Must be registered in your Meta app; uses YOUR public URL.
META_REDIRECT_URI="https://portal.example.org/api/auth/instagram/callback"
META_GRAPH_API_VERSION="v21.0"
# BoardGameGeek XML API2 bearer token (register your app at BGG).
BGG_BEARER_TOKEN=""
# Feedback button: fine-grained PAT with "Issues: Read and write" on the
# repository that should receive feedback issues.
GITHUB_TOKEN=""
# MyMemory translation, optional contact mail raises the daily limit.
TRANSLATION_CONTACT_EMAIL=""
# YouTube Data API v3 key (Google Cloud Console → Credentials).
YOUTUBE_API_KEY=""

# --- Host port bindings (all 127.0.0.1 only; optional) ---
# APP_PORT="3000"
# POSTGRES_PORT="5432"
# S3_API_PORT="8333"
# Cron target, only if the app is reachable under another name:
# CRON_APP_URL="http://app:3000"
