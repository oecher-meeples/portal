{
  "name": "oecher-meeples",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run --exclude '' --include '**/*.live.test.ts'",
    "dup": "jscpd src",
    "licenses": "pnpm licenses list --prod",
    "licenses:generate": "tsx scripts/generate-third-party-licenses.ts",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run test",
    "prepare": "husky",
    "db:seed": "cross-env DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config prisma/seed.ts",
    "migrate:posts": "cross-env DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/migrate-mock-posts.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@neondatabase/auth": "0.4.2-beta",
    "@prisma/client": "6.19.3",
    "@vercel/blob": "^2.6.1",
    "@vercel/og": "^0.11.1",
    "@zxing/browser": "^0.2.1",
    "better-auth": "1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.10.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "node-ical": "^0.27.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jscpd": "^5.0.14",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "6.19.3",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vitest-mock-extended": "^5.1.0"
  }
}
