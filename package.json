{
  "name": "oecher-meeples",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev -p 3002",
    "dev:restart": "powershell -ExecutionPolicy Bypass -File scripts/restart-dev.ps1",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live": "cross-env VITEST_LIVE=1 DOTENV_CONFIG_PATH=.env.local node -r dotenv/config node_modules/vitest/vitest.mjs run live.test",
    "dup": "jscpd src",
    "licenses": "pnpm licenses list --prod",
    "licenses:generate": "tsx scripts/generate-third-party-licenses.ts",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run test",
    "prepare": "husky",
    "db:seed": "cross-env DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config prisma/seed.ts",
    "migrate:posts": "cross-env DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/migrate-mock-posts.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/s3-presigned-post": "^3.1173.0",
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vercel/og": "^1.0.3",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "better-auth": "1.7.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "fast-xml-parser": "^5.12.1",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.2",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "node-ical": "^0.27.6",
    "nodemailer": "^10.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jscpd": "^5.4.3",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "vitest-mock-extended": "^6.0.1"
  }
}
