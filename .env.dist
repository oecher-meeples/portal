# Self-hosting environment template for docker-compose.yml (see docs/deployment-docker.md).
#
#   cp .env.dist .env
#
# Fill in the values below, then start the stack with:
#   docker compose up -d --build

# --- General ---
ENVIRONMENT="production"
IMAGE_TAG="latest"

# --- Public URLs (what browsers / external services reach) ---
# Base URL of the portal, no trailing slash, no /api/auth.
BETTER_AUTH_URL="https://portal.example.org"
# Used for links in mails, Instagram captions and calendar subscription URLs.
PUBLIC_SITE_URL="https://portal.example.org"
# Public origin of the blob storage (images + direct browser uploads).
S3_PUBLIC_ENDPOINT="https://files.portal.example.org"
# Optional, comma-separated extra origins allowed to call /api/auth.
BETTER_AUTH_TRUSTED_ORIGINS=""

# --- Database (postgres service) ---
POSTGRES_USER="meeples"
# Keep URL-safe (e.g. `openssl rand -hex 24`); must match the password in DATABASE_URL.
POSTGRES_PASSWORD="generate-with-openssl-rand-hex-24"
POSTGRES_DB="meeples"
DATABASE_URL="postgresql://meeples:generate-with-openssl-rand-hex-24@postgres:5432/meeples"

# --- Auth & secrets ---
# Signs session cookies, reset tokens and Instagram OAuth state (`openssl rand -base64 32`).
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
# AES-256-GCM key for stored IBANs (`openssl rand -base64 32`). Back up outside this server!
MEMBER_DATA_ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"
# Bearer token for the app's /api/cron/* routes (`openssl rand -hex 32`).
CRON_SECRET="generate-with-openssl-rand-hex-32"

# --- First-start seed (only runs on an empty database) ---
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_PROFILE="release"
SEED_DEMO_PASSWORD="demo1234"

# --- Blob storage (seaweedfs + seaweedfs-init services) ---
# Admin identity (only used by seaweedfs-init for bucket/policy setup; `openssl rand -hex 20`).
SEAWEEDFS_ADMIN_ACCESS_KEY="generate-with-openssl-rand-hex-20"
SEAWEEDFS_ADMIN_SECRET_KEY="generate-with-openssl-rand-hex-20"
AWS_ACCESS_KEY_ID="generate-with-openssl-rand-hex-20"
AWS_SECRET_ACCESS_KEY="generate-with-openssl-rand-hex-20"
AWS_DEFAULT_REGION="us-east-1"
# App identity (Read/Write/List, no policy admin; `openssl rand -hex 20`).
S3_ACCESS_KEY="meeples-app"
S3_SECRET_KEY="generate-with-openssl-rand-hex-20"
S3_ENDPOINT="http://seaweedfs:8333"
S3_REGION="us-east-1"
S3_BUCKET="meeples"
S3_STORAGE_LIMIT_BYTES=""

# --- E-Mail (SMTP, optional; without SMTP_HOST mails are logged, not sent) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- Calendar feeds (optional) ---
PUBLIC_CALENDAR_ICS_URL=""
ICS_FEED_URL_INTERNAL=""

# --- External APIs, bring your own keys (optional per feature) ---
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI=""
META_GRAPH_API_VERSION="v21.0"
BGG_BEARER_TOKEN=""
GITHUB_TOKEN=""
TRANSLATION_CONTACT_EMAIL=""
YOUTUBE_API_KEY=""

# --- Host port bindings (127.0.0.1 only) ---
APP_PORT="3000"
POSTGRES_PORT="5432"
S3_API_PORT="8333"
